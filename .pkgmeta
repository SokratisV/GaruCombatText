# BigWigsMods packager config. The repo root *is* the addon, so the package is
# built from here and named "GaruCombatText" (the folder players extract into AddOns).
package-as: GaruCombatText

# Self-contained — no libraries pulled as externals, so no externals block and no
# separate "nolib" zip.
enable-nolib-creation: no

# Repo-meta files that shouldn't ship inside the addon zip. One path per line and
# nothing after it: the packager reads "tests   # a note" as a path named that, so a
# comment on the same line silently ships the file (v2.1.0 carried tests/ and
# logo.png that way).
#   tests     the offline checks, run from a dev checkout
#   logo.png  CurseForge project art, not needed inside the addon
ignore:
  - .github
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - tests
  - logo.png
